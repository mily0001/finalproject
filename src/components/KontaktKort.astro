---
const {
  navn = 'Daniel Abdo',
  rolle = 'Kundesupport',
  telefon = '+45 2065 7645',
  email = 'da@lufthavnsvikar.dk',
} = Astro.props;
---

<div class="kontakt-kort">
  <h3>{navn}</h3>

  <p class="rolle">({rolle})</p>

  <p>
    Telefon:
    <a href={`tel:${telefon}`}>{telefon}</a>
  </p>

  <p>
    E-mail:
    <a href={`mailto:${email}`}>{email}</a>
  </p>
</div>

<style>
  .kontakt-kort {
    background: #f8efe5;

    border-radius: 34px;

    padding: 28px;

    max-width: 400px;
    margin: 0 auto;

    margin-top: 15px;
  }

  .kontakt-kort h3 {
    font-size: 20px;
    font-weight: 700;

    color: #535453;
    margin-top: 5px;
    margin-bottom: 10px;
  }

  .rolle {
    font-size: 15px;

    color: #535453;

    margin-bottom: 12px;
  }

  .kontakt-kort p {
    font-size: 15px;

    color: #535453;

    margin-bottom: 10px;
  }

  .kontakt-kort a {
    color: #f8981c;

    text-decoration: none;
  }

  .kontakt-kort a:hover {
    text-decoration: underline;
  }

  @media screen and (max-width: 700px) {
    .kontakt-kort {
      padding: 20px;
      border-radius: 24px;

      max-width: 480px;
    }

    .kontakt-kort h3 {
      font-size: 24px;
    }

    .rolle,
    .kontakt-kort p {
      font-size: 20px;
    }
  }
</style>
