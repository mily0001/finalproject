---
const {
  navn = 'Daniel Abdo',
  rolle = 'Kundesupport',
  telefon = '+45 2065 7645',
  email = 'da@lufthavnsvikar.dk',
} = Astro.props;
---

<div class="kontakt-kort">
  <h3>{navn}</h3>

  <p class="rolle">({rolle})</p>

  <p>
    Telefon:
    <a class="telefon-link" href={`tel:${telefon}`}>{telefon}</a>
  </p>

  <p>
    E-mail:
    <a href={`mailto:${email}`}>{email}</a>
  </p>
</div>

<style>
  .kontakt-kort {
    background: #f8efe5;
    border-radius: 34px;
    padding: 24px;
    max-width: 400px;
    margin: 15px auto 0;
  }

  .kontakt-kort h3 {
    font-size: 20px;
    font-weight: 700;
    color: #535453;
    margin: 5px 0 10px;
  }

  .rolle {
    font-size: 15px;
    color: #535453;
    margin-bottom: 12px;
  }

  .kontakt-kort p {
    padding: 0;
    margin: 0 0 10px;
    font-size: 15px;
    color: #535453;
    text-align: left;
  }

  .kontakt-kort a {
    color: #f8981c;
    text-decoration: none;
  }

  .telefon-link {
    white-space: nowrap;
  }

  .kontakt-kort a:hover {
    text-decoration: underline;
  }

  .kontakt-kort a,
  .kontakt-kort a:visited,
  .kontakt-kort a:active {
    color: #f8981c;
    text-decoration: none;
  }

  @media screen and (max-width: 700px) {
    .kontakt-kort {
      padding: 22px;
      border-radius: 24px;
      max-width: 340px;
    }

    .kontakt-kort h3 {
      font-size: 22px;
    }

    .rolle,
    .kontakt-kort p {
      font-size: 16px;
      line-height: 1.4;
    }

    .kontakt-kort a {
      word-break: normal;
      overflow-wrap: normal;
    }
  }
</style>
