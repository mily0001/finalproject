---
const {
  title = 'AIRLINE SERVICE',
  text = `Vi kan assistere ved ledsagelse til Lufthavnens airside område - mekanikere eller repræsentanter.`,
  image = '/billeder/service.jpg',
  icon = '/billeder/fly-icon.svg',
} = Astro.props;
---

<div class="service-card">
  <div class="image-wrapper">
    <img src={image} alt={title} class="service-image" />

    <div class="icon-circle">
      <img src={icon} alt="" />
    </div>
  </div>

  <div class="service-content">
    <h3>{title}</h3>

    <p>{text}</p>
  </div>
</div>

<style>
  .service-card {
    background: #f3f3f3;

    border-radius: 34px;

    height: 580px;
    padding: 20px;

    max-width: 400px;

    margin: 0 auto;

    margin-top: 50px;
  }
  .service-card:hover {
    transform: scale(1.03);
  }

  .image-wrapper {
    position: relative;

    margin-bottom: 34px;
  }

  .service-image {
    width: 100%;
    height: 220px;

    object-fit: cover;

    border-radius: 28px;
  }

  .icon-circle {
    position: absolute;

    left: 14px;
    bottom: -42px;

    width: 110px;
    height: 110px;

    background: white;

    border-radius: 50%;

    display: flex;
    justify-content: center;
    align-items: center;
  }

  .icon-circle img {
    width: 100px;
    height: 100px;

    object-fit: contain;
  }

  .service-content {
    padding: 0 12px 12px;
  }

  .service-content h3 {
    font-size: 28px;
    font-weight: 800;
    margin-left: 0px;
    color: #535453;

    margin-bottom: 24px;
  }

  .service-content p {
    font-size: 16px;
    /* line-height: 1.5; */
    width: 430px;
    margin-left: -45px;
    color: #222;
    margin-top: -25px;
  }

  @media screen and (max-width: 700px) {
    .service-card {
      padding: 20px;
      border-radius: 24px;
    }

    .service-image {
      height: 220px;
    }

    .icon-circle {
      width: 90px;
      height: 90px;

      bottom: -35px;
    }

    .icon-circle img {
      width: 100px;
      height: 100px;
    }

    .service-content h3 {
      font-size: 22px;
    }

    .service-content p {
      font-size: 16px;
    }
  }
</style>
