---
import MenuScript from './MenuScript.astro';
---

<article>
  <header>
    <!-- LOGO -->
    <div class="logo">
      <a href="/">
        <img src="../billeder/logo.png" alt="Logo" />
      </a>
    </div>

    <!-- BESTIL -->
    <a href="/bestil" class="cta-btn header-cta"> Bestil ledsager </a>

    <!-- NAV -->
    <nav>
      <ul class="menu">
        <li><a href="/">Hjem</a></li>
        <li><a href="/service">Services</a></li>
        <li><a href="/omos">Om os</a></li>
        <li><a href="/kontakt">Kontakt</a></li>
      </ul>

      <div class="burger">
        <div class="line"></div>
        <div class="line"></div>
        <div class="line"></div>
      </div>
    </nav>

    <!-- EXTRA -->
    <div class="extra-buttons">
      <!-- ROLE SWITCH -->
      <div class="role-slider">
        <div class="slider-bg"></div>

        <button class="role" data-role="jobs"> Jobsøgende </button>

        <button class="role active" data-role="company"> Virksomheder </button>
      </div>

      <!-- LANGUAGE -->
      <div class="lang-toggle">
        <button class="lang active" data-lang="da">DK</button>
        <span>/</span>
        <button class="lang" data-lang="en">EN</button>
      </div>

      <div id="google_translate_element"></div>
    </div>
  </header>
</article>

<MenuScript />

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  header {
    position: sticky;
    top: 0;
    z-index: 10;

    display: flex;
    justify-content: space-between;
    align-items: center;

    padding: 20px;
    background: white;
  }

  /* LOGO */

  .logo img {
    width: 250px;
    height: 50px;
  }

  /* NAV */

  nav {
    display: flex;
    align-items: center;
  }

  .menu {
    display: flex;
    list-style: none;
  }

  .menu li {
    margin-right: 20px;
  }

  .menu li:last-child {
    margin-right: 0;
  }

  .menu a {
    display: block;
    padding: 10px;
    color: #535453;
    text-decoration: none;
    transition: color 0.3s;
    font-weight: 300;
  }

  .menu a:hover {
    color: #f8981c;
    font-weight: 400;
  }

  /* EXTRA BUTTONS */

  .extra-buttons {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  /* ROLE SLIDER */

  .role-slider {
    position: relative;
    display: flex;
    background: #535453;
    border-radius: 999px;
    padding: 4px;
    overflow: hidden;
  }

  .slider-bg {
    position: absolute;
    top: 4px;
    left: 4px;

    width: calc(50% - 4px);
    height: calc(100% - 8px);

    background: #f8981c;
    border-radius: 999px;

    transition: 0.3s ease;

    transform: translateX(100%);
  }

  .role {
    position: relative;
    z-index: 2;

    border: none;
    background: none;

    padding: 8px 16px;

    cursor: pointer;

    font-size: 13px;
    color: white;
  }

  /* LANGUAGE */

  .lang-toggle {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .lang-toggle button {
    background: none;
    border: none;
    cursor: pointer;
    color: #535453;
  }

  .lang-toggle button.active {
    color: #f8981c;
    font-weight: 600;
  }

  #google_translate_element {
    display: none;
  }

  /* CTA */

  .cta-btn {
    padding: 10px 16px;

    border: 2px solid #f8981c;
    border-radius: 70px;

    color: #f8981c;
    text-decoration: none;

    font-weight: 500;
    transition: 0.3s;
    white-space: nowrap;
  }

  .cta-btn:hover {
    background: #f8981c;
    color: white;
  }

  /* BURGER */

  .burger {
    width: 30px;
    height: 20px;
    cursor: pointer;
    display: none;
  }

  .burger .line {
    width: 100%;
    height: 2px;
    background-color: #333333;
    margin-bottom: 5px;
    transition: 0.2s linear;
  }

  /* TABLET */

  @media screen and (max-width: 1000px) {
    .logo img {
      width: 200px;
      height: auto;
    }

    .menu li {
      margin-right: 10px;
    }

    .extra-buttons {
      gap: 10px;
    }

    .role {
      padding: 7px 12px;
      font-size: 12px;
    }

    .cta-btn {
      padding: 8px 12px;
      font-size: 13px;
    }
  }
  /* TABLET */
  @media screen and (max-width: 1200px) and (min-width: 801px) {
    .extra-buttons {
      display: none;
    }

    .burger {
      display: block;
      margin-left: 35px;
    }

    .logo img {
      width: 200px;
      height: auto;
    }

    .menu li {
      margin-right: 18px;
    }

    header.menu-open .extra-buttons {
      display: flex;

      flex-direction: row;
      align-items: center;
      gap: 18px;

      position: absolute;

      top: 70px;
      right: 25px;

      padding: 18px 22px;

      background: white;
      border-radius: 18px;

      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);

      z-index: 2;
    }
  }

  /* MOBILE */
  @media screen and (max-width: 800px) {
    header {
      display: grid;
      grid-template-columns: auto 1fr auto;

      align-items: center;
      gap: 12px;
    }

    .menu,
    .extra-buttons {
      display: none;
    }

    .burger {
      display: block;
      justify-self: end;
    }

    .header-cta {
      justify-self: center;
    }

    .burger.active .line:nth-child(1) {
      transform: rotate(45deg) translate(5px, 5px);
    }

    .burger.active .line:nth-child(2) {
      opacity: 0;
    }

    .burger.active .line:nth-child(3) {
      transform: rotate(-45deg) translate(5px, -5px);
    }

    nav.active .menu {
      display: flex;

      flex-direction: column;
      align-items: flex-start;

      position: absolute;

      top: 90px;
      left: 0;

      width: 100%;

      padding: 25px 20px 240px;

      background: white;

      box-shadow: 0 10px 10px rgba(0, 0, 0, 0.1);

      z-index: 1;
    }

    nav.active .menu li {
      margin: 6px 0;
    }

    nav.active .menu a {
      font-size: 22px;
      padding-left: 0;
    }

    header.menu-open .extra-buttons {
      display: flex;

      flex-direction: column;
      align-items: flex-start;

      gap: 14px;

      position: absolute;

      top: 430px;
      left: 20px;

      width: calc(100% - 40px);

      background: transparent;
      box-shadow: none;

      z-index: 2;
    }
  }

  /* SMALL MOBILE */
  /* SMALL MOBILE */
  @media screen and (max-width: 500px) {
    .logo img {
      width: 150px;
      height: auto;
    }

    .cta-btn {
      font-size: 12px;
      padding: 8px 10px;
    }

    nav.active .menu a {
      font-size: 18px;
    }

    header.menu-open .extra-buttons {
      top: 430px;
    }
  }
</style>
