---
const {
  title = 'AIRLINE SERVICE',
  image = '/billeder/airline-service.jpg',
  icon = '/billeder/fly-icon.svg',
  textOne = 'Vi kan assistere ved ledsagelse til Lufthavnens airside område - mekanikere eller repræsentanter. Vi kan assistere når der er processer der skal checkes - stor eller lille skala, og udfører repræsentation og supervision ved turnaround i CPH.',
  textTwo = 'Vi kan assistere ved ledsagelse til Lufthavnens airside område - mekanikere eller repræsentanter. Vi kan assistere når der er processer der skal checkes - stor eller lille skala, og udfører repræsentation og supervision ved turnaround i CPH.',
  pdfText = 'TERMS AND CONDITIONS',
  pdfLink = '/pdf/terms.pdf',
  pdfIcon = '/billeder/pdf-icon.svg',
} = Astro.props;
---

<section class="service-detail-card">
  <div class="service-detail-image">
    <img src={image} alt={title} />
  </div>

  <div class="service-detail-content">
    <div class="service-title-row">
      <h2>{title}</h2>

      <div class="service-icon-circle">
        <img src={icon} alt="" />
      </div>
    </div>

    <p>{textOne}</p>
    <p>{textTwo}</p>

    <a href={pdfLink} class="pdf-link">
      <img src={pdfIcon} alt="" />
      <span>{pdfText}</span>
    </a>
  </div>
</section>

<style>
  .service-detail-card {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 50px;
    align-items: center;

    max-width: 1400px;
    margin: 60px auto;
    padding: 0 30px;
  }

  .service-detail-image img {
    width: 100%;
    height: 410px;
    object-fit: cover;
    border-radius: 18px;
  }

  .service-detail-content {
    color: #535453;
  }

  .service-title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 30px;
    margin-bottom: 55px;
  }

  .service-title-row h2 {
    font-size: 42px;
    line-height: 1;
    font-weight: 800;
    letter-spacing: 1px;
    color: #535453;
    margin-top: 0px;
  }

  .service-icon-circle {
    width: 84px;
    height: 84px;
    border-radius: 50%;
    background: #f6f6f6;
    margin-right: 30px;

    display: flex;
    align-items: center;
    justify-content: center;

    flex-shrink: 0;
  }

  .service-icon-circle img {
    width: 68px;
    height: 68px;
    object-fit: contain;
  }

  .service-detail-content p {
    max-width: 650px;
    font-size: 15px;
    line-height: 1.35;
    margin-bottom: 28px;
    margin-top: -40px;
    color: black;
    margin-left: -40px;
  }

  .pdf-link {
    display: flex;
    align-items: center;
    gap: 26px;

    margin-top: 80px;

    color: black;
    text-decoration: none;
    font-size: 15px;
  }

  .pdf-link img {
    width: 52px;
    height: auto;
  }

  .pdf-link:hover span {
    color: #f8981c;
  }

  @media screen and (max-width: 900px) {
    .service-detail-card {
      grid-template-columns: 1fr;
      gap: 35px;

      max-width: 520px;
      margin: 40px auto;
      padding: 0 28px;
    }

    .service-detail-image img {
      width: 100%;
      height: auto;
      border-radius: 16px;
    }

    .service-title-row {
      display: flex;
      justify-content: space-between;
      align-items: center;

      margin-bottom: 40px;
    }

    .service-title-row h2 {
      font-size: 32px;
      line-height: 1.05;
    }

    .service-icon-circle {
      width: 72px;
      height: 72px;
    }

    .service-icon-circle img {
      width: 68px;
      height: 68px;
    }

    .service-detail-content p {
      font-size: 14px;
      line-height: 1.35;
      margin-bottom: 28px;
      margin-left: -40px;
    }

    .pdf-link {
      margin-top: 70px;
      gap: 22px;
      font-size: 12px;
    }

    .pdf-link img {
      width: 48px;
    }
  }
</style>
