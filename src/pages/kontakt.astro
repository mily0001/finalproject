---
import '../styles/style.css';
import '../styles/kontakt.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import KontaktKort from '../components/KontaktKort.astro';

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<!doctype html>
<html lang="da">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>Kontakt</title>
  </head>
  <body>
    <main>
      <Header />

      <h1>Kontakt</h1>
      <p>
        Uanset om du har spørgsmål til vores services, ønsker et uforpligtende tilbud eller vil høre
        mere om mulighederne for samarbejde, er du altid velkommen til at kontakte os. Vores team
        har mange års erfaring fra lufthavns- og servicebranchen og hjælper dig gerne videre.
        Herunder finder du kontakt personer indenfor diverse afdelinger og områder. Ellers er du
        også velkommen til at ringe til kontoret på kundesupport nummeret.
      </p>

      <div class="orange">
        <div class="kontakt-row">
          <div class="kontakt-box">
            <h3>KUNDESUPPORT:</h3>
            <p>+45-00000000</p>
          </div>

          <div class="kontakt-box">
            <h3>REKRUTTERING:</h3>
            <p>+45-00000000</p>
          </div>
        </div>
      </div>

      <div class="kontaktkolonner">
        <div class="kundesupport">
          <h2>Medarbejdere i kundesupport</h2>
          <KontaktKort />
          <KontaktKort
            navn="Edina Pilavac"
            rolle="Kundesupport"
            telefon="+45 2178 3455"
            email="ep@lufthavnsvikar.dk"
          />
          <KontaktKort
            navn="Calle Eliasson"
            rolle="Kundesupport"
            telefon="+45 9388 2139"
            email="ce@lufthavnsvikar.dk"
          />

          <KontaktKort
            navn="Frederik Metzsch Johansen"
            rolle="Kundesupport"
            telefon="+45 9389 2139"
            email="fj@lufthavnsvikar.dk"
          />

          <KontaktKort
            navn="Natasha Rasmussen Harboe"
            rolle="Kundesupport"
            telefon="+45 2139 0080"
            email="nh@lufthavnsvikar.dk"
          />

          <KontaktKort
            navn="Sema Kücükkaraca"
            rolle="Kundesupport"
            telefon="+45 2139 0080"
            email="support@lufthavnsvikar.dk"
          />
        </div>

        <div class="indehavere">
          <h2>Indehavre og partnere</h2>
          <KontaktKort
            navn="Peter Urhammer"
            rolle="Partner"
            telefon="+45 2139 0081"
            email="pu@lufthavnsvikar.dk"
          />
          <KontaktKort
            navn="Sofie Højmose Olesen"
            rolle="Indehaver"
            telefon="+45 3028 7705"
            email="sh@lufthavnsvikar.dk"
          />

          <KontaktKort
            navn="Claus Karoli"
            rolle="Indehaver og partner"
            telefon="+45 2139 0082"
            email="ck@lufthavnsvikar.dk"
          />
        </div>

        <div class="administrationen">
          <h2>Medarbejdere i administrationen</h2>
          <KontaktKort
            navn="Sofie Højmose Olesen"
            rolle="Flyselskabs- & Kundesupport + administration"
            telefon="+45 3028 7705"
            email="sh@lufthavnsvikar.dk"
          />

          <KontaktKort
            navn="Dina N. Johansen"
