            rolle="HR Konsulent - på barsel"
            telefon="+45 8177 8814"
            email="el@lufthavnsvikar.dk"
          />
        </div>
        <div class="promotion">
          <h2>Promotion</h2>
          <KontaktKort
            navn="Lykke Ellingsen"
            rolle="Promotion Planner"
            telefon="+45 9387 2139"
            email="le@lufthavnsvikar.dk"
          />

