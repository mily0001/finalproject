---
import '../styles/style.css';
import '../styles/service.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ServiceKort from '../components/ServiceKort.astro';

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<!doctype html>
<html lang="da">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>Services</title>
  </head>
  <body>
    <main>
      <Header />
      <img src="/billeder/heroservice.png" alt="" class="hero" />

      <div class="gridservice">
        <div>
          <h1>Services</h1>
          <p>
            Der er et bredt udvalg af services der bliver tilbudt af lufthavnsvikar. Klik gerne på
            den ønskede service for at lære mere. hvis du har andre henvendelser er du velkommen til
            at kontakte kontoret på telefon eller mail. Du kan finde andre kontakter på vores
            kontakt side.
          </p>
        </div>
        <a href="/service1">
          <ServiceKort
            title="AIRLINE SERVICE"
            text="Vi kan assistere ved ledsagelse til Lufthavnens airside område - mekanikere eller repræsentanter. Vi kan assistere når der er processer der skal checkes - stor eller lille skala, og udfører repræsentation og supervision ved turnaround i CPH."
            image="/billeder/airlinebild.png"
            icon="/billeder/airline.png"
          />
        </a>

        <a href="/service2">
          <ServiceKort
            title="LEDSAGELSE"
            text="Lufthavnsvikar tilbyder alle former for ledsagelse og lodsning af gæster med tjenstligt ærinde på lufthavnens sikrede områder. En autoriseret Lufthavnsvikar vil have grundig viden om lufthavnens adgangs- og øvrige forhold og tilsikre at adgangen til Københavns Lufthavn bliver så smidig som mulig. "
            image="/billeder/ledsagerbild.png"
            icon="/billeder/ledsager.png"
          />
        </a>

        <a href="/service3">
          <ServiceKort
            title="KURSER"
            text="Der er i luftfartsbranchen et stort behov for at uddanne og opkvalificere medarbejderne således at deres kompetencer til en hver tid matcher de daglige safety- og security udfordringer i lufthavnen. Virksomheder der ønsker at opkvalificere deres medarbejderes kompetencer i forhold til Security Awarness, køre-rettigheder på platformen eller udvidet visitor kursus er velkommen til at kontakte os for yderligere information og priser.  "
            image="/billeder/kurserbild.png"
            icon="/billeder/kurser.png"
          />
        </a>
        <a href="/service4">
          <ServiceKort
            title="RETAIL OG PROMOTION"
            text="Hos Lufthavnsvikar har vi siden 2008 haft vores egen Retail vikar- og rekrutteringsplatform, målrettet vores Butik og Retail kunder i Københavns Lufthavn.
Med vores specialviden omkring passager flow og processer i Lufthavnen, og vores engagerede og professionelle medarbejdere, kan vi med kort varsel levere det helt rigtige personalematch og præcis den fleksibilitet du ønsker, når der behov for det.  "
            image="/billeder/retailbild.png"
            icon="/billeder/retail.png"
          />
        </a>

        <a href="/service5">
          <ServiceKort
            title="VIKAR"
            text="Vi dækker dag til dag vikariater, samt længerevarende personaleløsninger for virksomhederne i lufthavnsmiljøet - blandt andet inden for: Service, support, vagt, sikkerhed, protection, planlægning, ekspedition, transport, distribution, kontor, butik og salg."
            image="/billeder/vikarbild.png"
            icon="/billeder/vikar.png"
          />
        </a>

        <a href="/service6">
          <ServiceKort
            title="SEARCH AND SELECT"
            text="Denne ansættelsesform starter som et vikariat, hvor I har mulighed for at se medarbejderen an, inden en eventuel fastansættelse.
Efter en forud aftalt vikar periode, kan medarbejderen kvit og frit overtages. "
            image="/billeder/serachbild.png"
            icon="/billeder/search.png"
          />
        </a>

        <a href="/kontakt">
          <ServiceKort
            title="ANDRE HENVENDELSER"
            text="Ved andre henvendelser, er I velkommen til at kontakte os på telefon eller mail. "
            image="/billeder/forsidebillede.png"
            icon="/billeder/andet.png"
          />
        </a>
      </div>
      <Footer />
    </main>
  </body>
</html>
