---
import '../styles/style.css';
import '../styles/servicesider.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ServiceSide from '../components/ServiceSide.astro';
// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<!doctype html>
<html lang="da">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>Vikar</title>
  </head>
  <body>
    <main>
      <Header />

      <ServiceSide
        title="VIKAR"
        image="/billeder/vikarbild.png"
        icon="/billeder/vikar.png"
        textOne="Lufthavnsvikar har ca. 250 medarbejdere med adgang til de fleste områder i lufthavnen. Vi dækker alle arbejdsområder og alle services der udføres både i og uden for lufthavnen, og stiller altid op med kort varsel."
        textTwo="Vi dækker dag til dag vikariater, samt længerevarende personaleløsninger for virksomhederne i lufthavnsmiljøet - blandt andet inden for: Service, support, vagt, sikkerhed, protection, planlægning, ekspedition, transport, distribution, kontor, butik og salg.

Vi er medlem af Dansk Industri (DIO II), og kender overenskomsterne for de fleste arbejdsområder i lufthavnen."
        pdfText=""
        pdfLink=""
        pdfIcon=""
      />

      <div class="grey">
        <section class="service-nav">
          <a href="#vikar-team"> Vikar team </a>

          <a href="#varelevering"> Varelevering </a>
        </section>
      </div>

      <div class="resten">
        <div class="serviceafsnit" id="vikar-team">
          <h2>Vikar Team</h2>
          <p>
            Vore vikarteams henvender sig til større kunder og afdelinger, som herigennem opnår et
            dedikeret team af medarbejdere, der kan træde til, når behovet opstår. Teamet vil af
            konkurrencemæssige hensyn kun være tilknyttet én kunde indenfor samme fagområde.
          </p>
        </div>

        <div class="serviceafsnit" id="varelevering">
          <h2>Varelevering</h2>
          <p>
            Lufthavnsvikar har et indgående kendskab til lufthavnens områder og processer, og kan
            varetage enkle såvel som komplekse Lufthavnsleverancer efter ønske og behov. Vi udfører
            flere forskellige lager- og leveranceopgaver for vores kunder både i og udenfor
            Lufthavnen. Vi har medarbejdere med mange års erfaring i lagerstyring og varehåndtering,
            og kan altid hjælpe ved store som små opgaver. Har din virksomhed brug for at modtage
            eller levere vare til de sikkerhedskritiske områder i lufthavnen, skal varerne som
            udgangspunkt leveres og screenes i lufthavnens østlige varegård, beliggende på Tværvej
            E, 2770 Kastrup. Efter sikkerhedsgodkendelsen kan varerne transporteres via
            Terminalområdet til modtager sted. Ønsker din virksomhed hjælp til særlige leverancer og
            øvrige passage muligheder, eller rådgivning omkring Kendt leverandør koncept, er det
            helt gratis at kontakte Lufthavnsvikar for uddybende information.
          </p>
        </div>
      </div>

      <Footer />
    </main>
  </body>
</html>
